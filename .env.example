DB_PASSWORD=

# JWT Token (minimum 32 characters required)
JWT_TOKEN_KEY=

# Email / SMTP Configuration
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=your-full-gmail-address@gmail.com
# For Gmail, use a 16-character Google App Password, not your normal account password.
EMAIL_SMTP_PASSWORD=your-google-app-password-without-spaces
EMAIL_FROM_EMAIL=your-full-gmail-address@gmail.com
EMAIL_FROM_NAME=TalentVerse

# Cloudinary (Image Upload Service)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe (Payment Processing)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Google OAuth (Sign-In + Calendar Integration)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (Sign-In)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Frontend URL (for CORS and OAuth redirects)
FRONTEND_URL=

# Environment
ASPNETCORE_ENVIRONMENT=
